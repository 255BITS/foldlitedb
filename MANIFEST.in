include LICENSE README.md DESIGN.md
recursive-include native *.rs *.toml Cargo.lock *.txt
recursive-include views *.ts *.json *.mjs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include examples *.py
recursive-include docs *.html *.json *.css *.js *.svg
recursive-include src/foldlitedb/reducers/assets *
global-exclude __pycache__ *.py[cod]
prune native/target
prune views/node_modules
prune views/.build
